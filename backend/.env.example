# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,https://tbadmin.vercel.app

# Database & Cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talentbridge_analytics
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min32chars
JWT_EXPIRES_IN=7d

# Feature Flags
RBAC_ENABLED=false

# PostHog API Integration
POSTHOG_API_KEY=phx_read_only_api_key_placeholder
POSTHOG_PROJECT_ID=12345
POSTHOG_HOST=https://app.posthog.com

# Mailgun API & Webhook Integration
MAILGUN_API_KEY=key-mailgun_placeholder
MAILGUN_DOMAIN=mg.talentbridge.io
MAILGUN_WEBHOOK_SIGNING_KEY=signing_key_placeholder

# Buffer API Integration (GraphQL API — see https://developers.buffer.com)
BUFFER_API_KEY=your-buffer-api-key-here
BUFFER_API_URL=https://api.buffer.com
BUFFER_ORGANIZATION_ID=your-buffer-organization-id

# LinkedIn API Integration (Organic)
LINKEDIN_CLIENT_ID=your-client-id
LINKEDIN_CLIENT_SECRET=your-client-secret
LINKEDIN_COMPANY_URN=urn:li:organization:12345
LINKEDIN_REFRESH_TOKEN=your-refresh-token

# Reddit API Integration
REDDIT_CLIENT_ID=your-client-id
REDDIT_CLIENT_SECRET=your-client-secret
REDDIT_REFRESH_TOKEN=your-refresh-token
REDDIT_USER_AGENT=TalentBridge Analytics (by /u/your-username)



