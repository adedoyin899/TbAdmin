{
  "name": "talentbridge-analytics-api",
  "version": "1.0.0",
  "description": "TalentBridge Analytics API Gateway for PostHog, Mailgun, and Admin Portal",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts up",
    "migrate:rollback": "tsx src/db/migrate.ts down",
    "seed": "tsx src/db/seeders/admin_users.ts",
    "test:auth": "tsx src/tests/auth.test.ts",
    "test:cache": "tsx src/tests/cache.test.ts",
    "test:funnel": "tsx src/tests/funnel.test.ts",
    "test:dashboards": "tsx src/tests/dashboards.test.ts",
    "test:users": "tsx src/tests/users.test.ts",
    "test": "tsx src/tests/auth.test.ts && tsx src/tests/cache.test.ts && tsx src/tests/funnel.test.ts && tsx src/tests/dashboards.test.ts && tsx src/tests/users.test.ts"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
